# Nostr Shorts DVM Configuration

# DVM private key (nsec or hex) - used for decrypting DMs and sending replies
Nostr__PrivateKey=nsec1...

# Optional: separate key for publishing events (if empty, uses PrivateKey)
Nostr__PublishPrivateKey=

# npub (or hex pubkey) to accept DMs from
Nostr__ListenFromNpub=npub1...

# Relays
Nostr__Relays__0=wss://relay.damus.io
Nostr__Relays__1=wss://nos.lol

# Event kind to publish: 1 (note) or 34235 (NIP-71 video)
Nostr__EventKind=1

# Blossom server URL
Blossom__ServerUrl=https://your-blossom-server.com
