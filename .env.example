# Nostr Shorts DVM Configuration

# DVM private key (nsec or hex) - used for decrypting DMs and sending replies
Nostr__PrivateKey=nsec1...

# Optional: legacy single-account config (prefer Accounts[] below)
Nostr__PublishPrivateKey=
Nostr__ListenFromNpub=

# Account pairs: each maps a listener (who sends DMs) to a publish key (who posts videos)
# You can add multiple accounts by incrementing the index
Nostr__Accounts__0__PublishPrivateKey=nsec1...or_hex
Nostr__Accounts__0__ListenFromNpub=npub1...or_hex
# Nostr__Accounts__1__PublishPrivateKey=nsec1...or_hex
# Nostr__Accounts__1__ListenFromNpub=npub1...or_hex

# Relays
Nostr__Relays__0=wss://relay.damus.io
Nostr__Relays__1=wss://nos.lol

# Event kind to publish: 1 (note) or 34235 (NIP-71 video)
Nostr__EventKind=1

# Default zap split % to creator when creator pubkey is provided (0-100)
Nostr__DefaultCreatorZapShare=50

# Lightning address for receiving zaps (set on publish account profiles)
Nostr__LightningAddress=your-address@wallet.com

# Blossom server URL
Blossom__ServerUrl=https://your-blossom-server.com
